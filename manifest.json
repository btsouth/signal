{
  "schemaVersion": 1,
  "id": "tsouth89.signal",
  "name": "Signal",
  "version": "1.0.0",
  "author": "tsouth89",
  "license": "MIT",
  "description": "A quiet Sentry incident inbox for the Omarchy bar. Production stays invisible until it needs you.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Signal.qml"
  },
  "barWidget": {
    "displayName": "Signal",
    "description": "Watch unresolved Sentry issues, inspect regressions, and resolve incidents without living in a dashboard.",
    "category": "Development",
    "aliases": ["sentry", "errors", "incidents", "production"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300,
      "environment": "production",
      "sortOrder": "Recommended",
      "maxIssues": 50,
      "alertMode": "Regressions and escalating",
      "demoMode": false
    },
    "schema": [
      { "key": "refreshIntervalSec", "type": "integer", "label": "Refresh interval (seconds)", "min": 60, "max": 3600, "step": 60, "defaultValue": 300 },
      { "key": "environment", "type": "string", "label": "Environment", "defaultValue": "production", "description": "Leave empty to include every Sentry environment." },
      { "key": "sortOrder", "type": "enum", "label": "Sentry sort order", "options": ["Recommended", "Last seen", "Events", "Users", "Trending", "First seen"], "defaultValue": "Recommended" },
      { "key": "maxIssues", "type": "integer", "label": "Maximum issues", "min": 10, "max": 100, "step": 10, "defaultValue": 50 },
      { "key": "alertMode", "type": "enum", "label": "Desktop alerts", "options": ["Regressions and escalating", "Regressions only", "Off"], "defaultValue": "Regressions and escalating", "description": "The first successful refresh establishes a quiet baseline." },
      { "key": "demoMode", "type": "boolean", "label": "Use demonstration data", "defaultValue": false, "description": "Shows a realistic incident feed without contacting Sentry." }
    ]
  }
}
