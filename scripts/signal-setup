#!/usr/bin/env bash
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
config_dir="$config_home/omarchy/signal"
config_file="$config_dir/config.json"

command -v secret-tool >/dev/null || { printf 'Signal needs libsecret (secret-tool).\n'; read -r -p 'Press Enter to close.'; exit 1; }
command -v jq >/dev/null || { printf 'Signal needs jq.\n'; read -r -p 'Press Enter to close.'; exit 1; }
command -v curl >/dev/null || { printf 'Signal needs curl.\n'; read -r -p 'Press Enter to close.'; exit 1; }

clear
printf '\n  SIGNAL · CONNECT SENTRY\n\n'
printf 'Create a Sentry token with org:read, project:read, event:read,\n'
printf 'and event:write if you want Resolve and Ignore actions.\n\n'
current_org=$(jq -r '.organization // empty' "$config_file" 2>/dev/null || true)
current_url=$(jq -r '.baseUrl // empty' "$config_file" 2>/dev/null || true)
read -r -p "Organization slug${current_org:+ [$current_org]}: " organization
organization=${organization:-$current_org}
[[ $organization =~ ^[A-Za-z0-9._-]+$ ]] || { printf '\nInvalid organization slug.\n'; read -r -p 'Press Enter to close.'; exit 1; }
read -r -p "Sentry API origin [${current_url:-https://sentry.io}]: " base_url
base_url=${base_url:-${current_url:-https://sentry.io}}
base_url=${base_url%/}
[[ $base_url =~ ^https://[^/]+(:[0-9]+)?$ ]] || { printf '\nUse an HTTPS origin without a path.\n'; read -r -p 'Press Enter to close.'; exit 1; }
read -r -s -p 'Authentication token: ' token
printf '\n'
[[ -n $token ]] || { printf '\nToken cannot be empty.\n'; read -r -p 'Press Enter to close.'; exit 1; }
[[ $token =~ ^[A-Za-z0-9._-]+$ ]] || { printf '\nToken format is invalid.\n'; unset token; read -r -p 'Press Enter to close.'; exit 1; }

printf '\nChecking organization and token permissions…\n'
probe=$(mktemp)
trap 'rm -f "$probe"' EXIT
probe_url="$base_url/api/0/organizations/$organization/issues/?query=is%3Aunresolved&limit=1"
status=$(printf 'header = "Authorization: Bearer %s"\n' "$token" | curl --config - -sS --connect-timeout 5 --max-time 20 -o "$probe" -w '%{http_code}' -H 'Accept: application/json' "$probe_url") || {
  printf '\nCould not reach Sentry. Check the API origin and network.\n'; unset token; read -r -p 'Press Enter to close.'; exit 1;
}
if [[ $status != 200 ]] || ! jq -e 'type == "array"' "$probe" >/dev/null 2>&1; then
  case "$status" in
    401) message='Sentry rejected this token.' ;;
    403) message='The token needs event:read or event:write.' ;;
    404) message='The organization slug was not found at this API origin.' ;;
    *) message=$(jq -r '.detail // .message // "Sentry rejected the connection."' "$probe" 2>/dev/null || printf 'Sentry rejected the connection.') ;;
  esac
  printf '\n%s\nNothing was changed.\n' "$message"
  unset token
  read -r -p 'Press Enter to close.'
  exit 1
fi

mkdir -p "$config_dir"
chmod 700 "$config_dir"
tmp=$(mktemp "$config_dir/config.XXXXXX")
trap 'rm -f "$tmp" "$probe"' EXIT
jq -n --arg organization "$organization" --arg baseUrl "$base_url" '{organization:$organization,baseUrl:$baseUrl}' >"$tmp"
chmod 600 "$tmp"
mv "$tmp" "$config_file"
trap - EXIT
printf '%s' "$token" | secret-tool store --label='Signal Sentry token' service tsouth89.signal organization "$organization"
unset token

printf '\nConnected to %s. Signal will refresh when its panel opens.\n\n' "$organization"
read -r -p 'Press Enter to close.'
